# =============================================================================
# AMMS UI — environment template (enterprise)
# Copy to config/ui/.env.development (local Vite) or set in CI/CD for builds.
# Only VITE_* keys are embedded in the browser bundle. Never put secrets here.
# Vite loads this directory via envDir (see ui/vite.config.js).
# =============================================================================

# development | production | test
VITE_APP_ENV=development

# Document title / branding
VITE_APP_TITLE=AMMS Workflow Engine

# API base for Axios.
# Prefer same-origin path in development so Vite proxies /api → Spring (no CORS).
# Production builds should use the absolute public API URL.
VITE_API_URL=/api/v1

# Upstream target for Vite dev/preview proxy (not exposed to the browser)
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Axios timeout (ms)
VITE_API_TIMEOUT_MS=30000

# Dev server port (also overridable via UI_PORT in config/.env)
VITE_UI_PORT=15173
