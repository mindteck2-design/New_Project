# =============================================================================
# AMMS — top-level environment (prompt requirement)
# Copy to `.env` in the repo root. Never commit real secrets.
# scripts/common.sh loads this file, then optional config/.env overrides.
# =============================================================================

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=18080

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=amms
POSTGRES_USER=amms
POSTGRES_PASSWORD=amms_dev

MONGODB_URI=mongodb://127.0.0.1:27017/amms
AMMS_FORMS_STORE=postgres

JWT_SECRET=change-me-to-a-long-random-dev-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
AMMS_ATTACHMENTS_DIR=.data/attachments
AMMS_ATTACHMENTS_STORE=filesystem
MINIO_BUCKET=amms

UI_PORT=15173
AMMS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# Seeded passwords (dev only)
SEED_PASSWORD=Passw0rd!

# UI Vite vars also live under config/ui/.env.development (same-origin /api proxy)
